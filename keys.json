{
  "global": {
    "cmd-q": "app.quit",
    "cmd-h": "app.hide",
    "cmd-alt-h": "app.hide_others",
    "cmd-t": "tab.new",
    "cmd-w": "tab.close",
    "ctrl-tab": "tab.next",
    "ctrl-shift-tab": "tab.prev",
    "cmd-shift-]": "tab.next",
    "cmd-shift-[": "tab.prev",
    "cmd-alt-]": "space.next",
    "cmd-alt-[": "space.prev",
    "cmd-]": "agent.next",
    "cmd-[": "agent.prev",
    "cmd-shift-l": "layout.switch",
    "cmd-n": "space.new",
    "cmd-p": "mod.open:picker",
    "cmd-shift-p": "app.palette",
    "cmd-,": "app.settings",
    "cmd-d": "pane.split:right",
