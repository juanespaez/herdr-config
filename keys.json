    "cmd-1": "tab.select:1",
    "cmd-2": "tab.select:2",
    "cmd-3": "tab.select:3",
    "cmd-4": "tab.select:4",
    "cmd-5": "tab.select:5",
    "cmd-6": "tab.select:6",
    "cmd-7": "tab.select:7",
    "cmd-8": "tab.select:8",
    "cmd-9": "tab.select:9",
    "ctrl-1": "space.select:1",
    "ctrl-2": "space.select:2",
    "ctrl-3": "space.select:3",
    "ctrl-4": "space.select:4",
    "ctrl-5": "space.select:5",
    "ctrl-6": "space.select:6",
    "ctrl-7": "space.select:7",
    "ctrl-8": "space.select:8",
    "ctrl-9": "space.select:9",
    "ctrl-shift-t": "keyhelper.focus",
    "ctrl-shift-f": "keyhelper.files",
    "ctrl-shift-g": "keyhelper.changes",
    "ctrl-shift-n": "pane.split:right",
    "ctrl-shift-c": {
      "command": "tab.new",
      "args": {
        "argv": [
          "env",
          "CLAUDE_CONFIG_DIR=__HOME__/.claude-personal",
          "claude"
        ]
      }
    },
    "ctrl-shift-v": {
      "command": "tab.new",
      "args": {
        "argv": [
          "env",
          "-u",
          "CLAUDE_CONFIG_DIR",
          "claude"
        ]
      }
    },
    "ctrl-shift-p": {
      "command": "tab.new",
      "args": {
        "argv": [
          "env",
          "CLAUDE_CONFIG_DIR=__HOME__/.claude-pechiche",
          "claude"
        ]
      }
    },
    "ctrl-shift-q": "pane.close",
    "cmd-shift-j": "space.next",
    "cmd-shift-k": "space.prev",
    "ctrl-shift-e": "pane.zoom",
    "ctrl-shift-z": "space.next",
    "ctrl-shift-x": "space.prev",
    "ctrl-shift-l": "pane.go:right",
    "ctrl-alt-l": "pane.swap:right",
    "ctrl-shift-k": "pane.go:left",
    "ctrl-alt-k": "pane.swap:left",
    "ctrl-shift-i": "pane.go:up",
    "ctrl-alt-i": "pane.swap:up",
    "ctrl-shift-m": "pane.go:down",
    "ctrl-alt-m": "pane.swap:down",
    "ctrl-shift-b": "pane.split:down",
